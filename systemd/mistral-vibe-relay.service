[Unit]
Description=mistral-vibe-relay - OpenAI-compatible relay that spends the Mistral Vibe budget
Documentation=file://__RELAY_DIR__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=__ENV_FILE__
WorkingDirectory=__RELAY_DIR__
ExecStart=/usr/bin/env python3 __RELAY_DIR__/relay.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__RELAY_DIR__

[Install]
WantedBy=default.target
